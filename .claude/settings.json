{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "IMPECCABLE_CONTEXT_DIR": ".claude/design"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git merge --abort:*)",
      "Bash(git merge --no-ff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(graphify affected:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify path:*)",
      "Bash(graphify query:*)",
      "Bash(graphify update:*)",
      "Bash(jq:*)",
      "Bash(mkdir:*)",
      "Bash(mktemp:*)",
      "Bash(node \"$HOME\"/.claude/:*)",
      "Bash(node $HOME/.claude/:*)",
      "Bash(node --version)",
      "Bash(node ./.claude/:*)",
      "Bash(node .claude/:*)",
      "Bash(node ~/.claude/:*)",
      "Bash(npx tsc:*)",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "mcp__context7__*",
      "mcp__github__*",
      "mcp__playwright__*",
      "mcp__serena__*",
      "mcp__railway-mcp-server__*",
      "mcp__plugin_serena_serena__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_logbook_ledger__*",
      "mcp__ledger__*",
      "Skill(logbook:preflight)",
      "Skill(logbook:preflight:*)",
      "Skill(logbook:debrief)",
      "Skill(logbook:debrief:*)",
      "Skill(logbook:*)",
      "mcp__plugin_receipts_trajectory-kb__*",
      "mcp__plugin_github_github__*",
      "mcp__Claude_Browser__*",
      "mcp__claude-in-chrome__*",
      "mcp__Claude_Code_iOS_Simulator__*",
      "mcp__ccd_session__*",
      "mcp__ccd_session_mgmt__*",
      "mcp__ccd_directory__*",
      "mcp__mcp-registry__*",
      "mcp__scheduled-tasks__*",
      "mcp__terminal__*",
      "mcp__visualize__*",
      "Bash(node --test:*)",
      "Bash",
      "Bash(node:*)"
    ],
    "deny": [
      "Bash(supabase db push:*)",
      "Bash(supabase db pull:*)",
      "Bash(supabase migration up:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase link:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "mcp__github__create_pull_request",
      "mcp__plugin_github_github__create_pull_request",
      "mcp__github__create_pull_request_with_copilot",
      "mcp__plugin_github_github__create_pull_request_with_copilot",
      "mcp__github__update_pull_request",
      "mcp__plugin_github_github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__plugin_github_github__merge_pull_request",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.pypirc)",
      "Read(~/Library/Keychains/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-complete.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/graphify-refresh.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-input.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/dep-audit.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/graphify-provision.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ledger-staleness-scan.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/superpowers-cmd-hook-heal.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plugin-update-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-ledger/roster-index-gen.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ledger-resume-roster.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/secret-scanner.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-destructive-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-deep-research.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-ledger/agent-fallback-capture.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/allow-write-tools.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/lint-on-edit.sh",
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-ledger/agent-permission-capture.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/observer/subagent-observer.mjs",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/observer/subagent-observer.mjs",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.27",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "vscode-langservers@claude-code-lsps": true,
    "visual-explainer@visual-explainer-marketplace": true,
    "warp@claude-code-warp": true,
    "logbook@logbook": true,
    "receipts@receipts": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    },
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      }
    },
    "receipts": {
      "source": {
        "source": "github",
        "repo": "shaheershoaib/receipts"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "pluginConfigs": {
    "logbook@logbook": {
      "options": {
        "ledger_backend": "orphan-branch",
        "ledger_branch": "_ledger",
        "disable_trailer": false,
        "disable_bash_guard": true
      }
    }
  },
  "tui": "default",
  "autoMemoryEnabled": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
