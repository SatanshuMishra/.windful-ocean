{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "IMPECCABLE_CONTEXT_DIR": ".claude/design",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git merge --abort:*)",
      "Bash(git merge --no-ff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(graphify affected:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify path:*)",
      "Bash(graphify query:*)",
      "Bash(graphify update:*)",
      "Bash(jq:*)",
      "Bash(mkdir:*)",
      "Bash(mktemp:*)",
      "Bash(node \"$HOME\"/.claude/:*)",
      "Bash(node $HOME/.claude/:*)",
      "Bash(node --version)",
      "Bash(node ./.claude/:*)",
      "Bash(node .claude/:*)",
      "Bash(node ~/.claude/:*)",
      "Bash(npx tsc:*)",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "mcp__context7__*",
      "mcp__github__*",
      "mcp__playwright__*",
      "mcp__serena__*",
      "mcp__railway-mcp-server__*",
      "mcp__plugin_serena_serena__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_logbook_ledger__*",
      "mcp__ledger__*",
      "Skill(logbook:preflight)",
      "Skill(logbook:preflight:*)",
      "Skill(logbook:debrief)",
      "Skill(logbook:debrief:*)",
      "Skill(logbook:*)",
      "mcp__plugin_receipts_trajectory-kb__*",
      "mcp__plugin_github_github__*",
      "mcp__Claude_Browser__*",
      "mcp__claude-in-chrome__*",
      "mcp__Claude_Code_iOS_Simulator__*",
      "mcp__ccd_session__*",
      "mcp__ccd_session_mgmt__*",
      "mcp__ccd_directory__*",
      "mcp__mcp-registry__*",
      "mcp__scheduled-tasks__*",
      "mcp__terminal__*",
      "mcp__visualize__*",
      "Bash(node --test:*)",
      "Bash",
      "Bash(node:*)",
      "Bash(lab:*)",
      "Bash(tart:*)",
      "Bash(vmrun:*)",
      "Bash(xcrun simctl:*)",
      "Bash(adb:*)",
      "Bash(emulator:*)",
      "Bash(mobilecli:*)",
      "Bash(vncdo:*)",
      "Read(~/VMLab/shots/**)",
      "Read(~/VMLab/logs/**)",
      "mcp__mobile-mcp__*",
      "Bash(pull-request:*)",
      "Bash(pipeline:*)"
    ],
    "deny": [
      "Read(~/VMLab/keys/**)",
      "Read(~/VMLab/config/**)",
      "Bash(supabase db push:*)",
      "Bash(supabase db pull:*)",
      "Bash(supabase migration up:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase link:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "mcp__github__create_pull_request_with_copilot",
      "mcp__plugin_github_github__create_pull_request_with_copilot",
      "mcp__github__merge_pull_request",
      "mcp__plugin_github_github__merge_pull_request",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.pypirc)",
      "Read(~/Library/Keychains/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "autoCompactWindow": 400000,
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-complete.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/graphify-refresh.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-input.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/dep-audit.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/graphify-provision.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/superpowers-cmd-hook-heal.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plugin-update-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-ledger/roster-index-gen.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dotfiles-check.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/observer/session-observer.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/config-write-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/secret-scanner.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-destructive-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-deep-research.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-ledger/agent-fallback-capture.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/allow-write-tools.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/deny-hold-loop.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/deny-task-output-read.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/lint-on-edit.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-ledger/agent-permission-capture.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/observer/subagent-observer.mjs",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/observer/subagent-observer.mjs",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.29",
    "padding": 0
  },
  "outputStyle": "satanshu",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured \u2014 personal account `SatanshuMishra` (github.com:SatanshuMishra/.windful-ocean)",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PRIVATE \u2014 `SatanshuMishra/.windful-ocean` is private per the authenticated gh check on 2026-09-30; a push there stays within the owner's GitHub account",
      "**Internal sharing / snippet hosting**: None configured \u2014 treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: GitHub Actions secrets only \u2014 `GITHUB_TOKEN` referenced in CI for this repo",
      "**Default / protected branches**: default branch `main`; `main` is protected, and the active ruleset `Require PR for Merge` applies",
      "**CI/CD deploy targets**: None configured \u2014 `.github/workflows` present but no deploy target evidenced",
      "**Network posture**: None configured",
      "**Source control**: GitHub over SSH for `github.com:SatanshuMishra/.windful-ocean` only (no additional orgs configured) \u2014 as scoped by the Trusted repo and Repository visibility entries above",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured \u2014 public npm/Homebrew/cargo/composer registries only",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. In this repo specifically: the .gitignore'd secret paths and anything surfaced by `.claude/hooks/secret-scanner.sh`, plus `~/.zsh_history` and other dotfile histories under $HOME which carry inline secrets",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited \u2014 e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured \u2014 fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: dotfiles and personal development-environment maintenance (Neovim, Zsh, Tmux, Git config) plus general software development in this repo",
      "**Trusted repo**: `/Users/satanshumishra/Documents/DevLabs/.windful-ocean` and its configured remote `github.com:SatanshuMishra/.windful-ocean`. This repo is private; only that repo's own dotfiles work is OK to commit or push there \u2014 content ported, repointed, or first read from outside this session's repo is not its own work, whoever directed the port. Visibility scopes confidential material only: secrets and sensitive data (personal & entrusted) are never cleared into any repo by its visibility (see Definitions).",
      "**Org-specific CLIs**: None configured \u2014 observed tooling is standard (git, gh, npm/pnpm/npx, node, brew, cargo, composer, php, flutter, docker, tmux, stow, nvim)",
      "**Routine under this repo's prefix**: local dotfile linking and shell/editor config work under the repo checkout (e.g. `stow`) is routine; anything touching $HOME history files or ignored secret paths is not"
    ]
  }
}
